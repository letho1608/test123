[Unit]
Description=zen-proxy (Claude Code backend: opencode CLI local / Zen free tier)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/zen-claude-proxy
ExecStartPre=-/usr/bin/git -C %h/zen-claude-proxy pull --ff-only --quiet
ExecStart=/usr/bin/node %h/zen-claude-proxy/proxy.mjs
Environment=BACKEND=local
Environment=PORT=8898
# Backend Zen thi doi 2 dong tren thanh:
# Environment=BACKEND=zen
# Environment=ZEN_MODEL=muse-spark-1.3-contributor-free
# (local doc them: LOCAL_MODEL, LOCAL_SESSION, LOCAL_CWD, LOCAL_TIMEOUT_MS)
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
